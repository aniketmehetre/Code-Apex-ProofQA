{
  "$defs": {
    "Action": {
      "description": "Deterministic, replayable browser action.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionEvent": {
      "description": "Recorded action execution event.",
      "properties": {
        "type": {
          "const": "action",
          "default": "action",
          "title": "Type",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "timestamp_ms": {
          "default": 0.0,
          "title": "Timestamp Ms",
          "type": "number"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        }
      },
      "required": [
        "action"
      ],
      "title": "ActionEvent",
      "type": "object"
    },
    "ActionKind": {
      "description": "Enumeration of allowed deterministic browser actions.",
      "enum": [
        "goto",
        "click",
        "fill",
        "select",
        "press",
        "wait"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "ConsoleEvent": {
      "description": "Captured browser console output.",
      "properties": {
        "type": {
          "const": "console",
          "default": "console",
          "title": "Type",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "timestamp_ms": {
          "default": 0.0,
          "title": "Timestamp Ms",
          "type": "number"
        }
      },
      "required": [
        "level",
        "text"
      ],
      "title": "ConsoleEvent",
      "type": "object"
    },
    "Locator": {
      "description": "Multi-strategy element locator prioritized by semantic stability.",
      "properties": {
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "testid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Testid"
        },
        "css_fallback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Css Fallback"
        }
      },
      "title": "Locator",
      "type": "object"
    },
    "NetworkEvent": {
      "description": "Recorded network request/response pair.",
      "properties": {
        "type": {
          "const": "network",
          "default": "network",
          "title": "Type",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "integer"
        },
        "first_party": {
          "title": "First Party",
          "type": "boolean"
        },
        "request_body_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Body Hash"
        },
        "response_blob_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Blob Ref"
        },
        "timestamp_ms": {
          "default": 0.0,
          "title": "Timestamp Ms",
          "type": "number"
        }
      },
      "required": [
        "method",
        "url",
        "status",
        "first_party"
      ],
      "title": "NetworkEvent",
      "type": "object"
    },
    "PageErrorEvent": {
      "description": "Uncaught JavaScript runtime error or unhandled promise rejection.",
      "properties": {
        "type": {
          "const": "page_error",
          "default": "page_error",
          "title": "Type",
          "type": "string"
        },
        "error_type": {
          "title": "Error Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "stack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stack"
        },
        "timestamp_ms": {
          "default": 0.0,
          "title": "Timestamp Ms",
          "type": "number"
        }
      },
      "required": [
        "error_type",
        "message"
      ],
      "title": "PageErrorEvent",
      "type": "object"
    },
    "StateEvent": {
      "description": "Observed settled page state.",
      "properties": {
        "type": {
          "const": "state",
          "default": "state",
          "title": "Type",
          "type": "string"
        },
        "fingerprint": {
          "$ref": "#/$defs/StateFingerprint"
        },
        "timestamp_ms": {
          "default": 0.0,
          "title": "Timestamp Ms",
          "type": "number"
        }
      },
      "required": [
        "fingerprint"
      ],
      "title": "StateEvent",
      "type": "object"
    },
    "StateFingerprint": {
      "description": "Normalized page perception state signature.",
      "properties": {
        "url_path": {
          "title": "Url Path",
          "type": "string"
        },
        "aria_hash": {
          "title": "Aria Hash",
          "type": "string"
        },
        "simhash": {
          "title": "Simhash",
          "type": "string"
        },
        "control_count": {
          "title": "Control Count",
          "type": "integer"
        }
      },
      "required": [
        "url_path",
        "aria_hash",
        "simhash",
        "control_count"
      ],
      "title": "StateFingerprint",
      "type": "object"
    },
    "UiFactEvent": {
      "description": "Cross-layer extracted fact comparing UI representation against API truth.",
      "properties": {
        "type": {
          "const": "ui_fact",
          "default": "ui_fact",
          "title": "Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "ui_value": {
          "title": "Ui Value"
        },
        "api_value": {
          "title": "Api Value"
        },
        "api_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Ref"
        },
        "timestamp_ms": {
          "default": 0.0,
          "title": "Timestamp Ms",
          "type": "number"
        }
      },
      "required": [
        "label",
        "ui_value",
        "api_value"
      ],
      "title": "UiFactEvent",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "action": "#/$defs/ActionEvent",
      "console": "#/$defs/ConsoleEvent",
      "network": "#/$defs/NetworkEvent",
      "page_error": "#/$defs/PageErrorEvent",
      "state": "#/$defs/StateEvent",
      "ui_fact": "#/$defs/UiFactEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ActionEvent"
    },
    {
      "$ref": "#/$defs/NetworkEvent"
    },
    {
      "$ref": "#/$defs/ConsoleEvent"
    },
    {
      "$ref": "#/$defs/PageErrorEvent"
    },
    {
      "$ref": "#/$defs/StateEvent"
    },
    {
      "$ref": "#/$defs/UiFactEvent"
    }
  ]
}